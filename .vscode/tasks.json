      "runOptions": { "runOn": "folderOpen" }
    },
    {
      "label": "Validar contenidos",
      "type": "shell",
      "command": "npm run validar",
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "Generar archivo único",
      "type": "shell",
      "command": "npm run empaquetar",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
